{
  "name": "zcadmin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "zcadmin 管理后台前端（Vue 3.5 + Ant Design Vue 4）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "gen:api": "openapi-typescript ../contracts/openapi.json -o src/types/api.d.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.62.0",
    "ant-design-vue": "^4.2.6",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.1.10"
  }
}

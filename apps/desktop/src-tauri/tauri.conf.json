{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "卓才智能",
  "version": "0.1.0",
  "identifier": "com.zcadmin.desktop",
  "build": {
    "frontendDist": "../../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "卓才智能",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
